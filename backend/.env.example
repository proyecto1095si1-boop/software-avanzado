# === Software Avanzado — APIs externas ===
# Copiá este archivo a .env y completá solo lo que uses.
# NUNCA subas .env al repositorio.

# --- OBLIGATORIO: ya funciona sin clave ---
# CelesTrak (TLE público) — no requiere API key
# CELESTRAK_BASE=https://celestrak.org/NORAD/elements/gp.php

# --- Space Domain (recomendado) ---
# space-track.org → registrate en https://www.space-track.org
SPACETRACK_USER=
SPACETRACK_PASSWORD=

# n2yo.com → clave gratuita en https://www.n2yo.com/api/
N2YO_API_KEY=

# --- Aviones (ADS-B) ---
# Opción A: instancia propia (tar1090 / readsb)
# ADSB_API_URL=http://tu-servidor:8080/data/aircraft.json
# Opción B: API comercial (ADS-B Exchange, OpenSky, etc.)
ADSB_API_URL=
ADSB_API_KEY=

# --- Buques (AIS) ---
# AISStream, MarineTraffic, etc.
AIS_API_URL=
AIS_API_KEY=

# --- Cámaras / OSINT ---
# URL a un JSON propio de cámaras, o lista pública
CAMERA_LIST_URL=

# Shodan (opcional, uso responsable)
SHODAN_API_KEY=

# --- Sistema ---
TLE_CACHE_TTL=7200
